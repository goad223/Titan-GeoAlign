# =============================================================================
#  Titan-GeoAlign — GPU Dockerfile
#  Multi-stage build using NVIDIA CUDA 12.4 + cuDNN 8 runtime base.
#  Requires the NVIDIA Container Toolkit on the host.
# =============================================================================

# ── Stage 1: build wheels ─────────────────────────────────────────────────────
FROM nvidia/cuda:12.4.0-cudnn8-devel-ubuntu22.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.12

RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y --no-install-recommends \
      python${PYTHON_VERSION} \
      python${PYTHON_VERSION}-dev \
      python${PYTHON_VERSION}-venv \
      python3-pip \
      build-essential \
      gcc \
      g++ \
      git \
      curl \
      libgdal-dev \
      gdal-bin \
      libproj-dev \
      libgeos-dev \
      libspatialindex-dev \
      libhdf5-dev \
      libnetcdf-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN python${PYTHON_VERSION} -m pip install --upgrade pip setuptools wheel

WORKDIR /build

# GPU-specific PyTorch index
ARG TORCH_INDEX="https://download.pytorch.org/whl/cu124"

COPY requirements.txt requirements-gpu.txt* ./
RUN pip wheel --no-cache-dir --wheel-dir /wheels \
      --extra-index-url "${TORCH_INDEX}" \
      -r requirements.txt \
    && if [ -f requirements-gpu.txt ]; then \
         pip wheel --no-cache-dir --wheel-dir /wheels \
           --extra-index-url "${TORCH_INDEX}" \
           -r requirements-gpu.txt; \
       fi

# ── Stage 2: GPU runtime image ────────────────────────────────────────────────
FROM nvidia/cuda:12.4.0-cudnn8-runtime-ubuntu22.04 AS runtime

LABEL org.opencontainers.image.title="Titan-GeoAlign (GPU)"
LABEL org.opencontainers.image.description="Sub-pixel geospatial image alignment — GPU accelerated"
LABEL org.opencontainers.image.source="https://github.com/goad223/Titan-GeoAlign"
LABEL org.opencontainers.image.licenses="MIT"

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.12
ARG APP_USER=titan
ARG APP_UID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y --no-install-recommends \
      python${PYTHON_VERSION} \
      python${PYTHON_VERSION}-venv \
      python3-pip \
      libgdal30 \
      libproj22 \
      libgeos3.10.2 \
      libspatialindex6 \
      libhdf5-103 \
      libnetcdf19 \
      curl \
      tini \
    && rm -rf /var/lib/apt/lists/*

# Make python3.12 the default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python${PYTHON_VERSION} 1

RUN useradd --uid "${APP_UID}" --create-home --shell /bin/bash "${APP_USER}"

COPY --from=builder /wheels /wheels
RUN python3 -m pip install --no-cache-dir --no-index --find-links=/wheels /wheels/*.whl \
    && rm -rf /wheels

WORKDIR /app
COPY --chown=${APP_USER}:${APP_USER} . .
RUN python3 -m pip install --no-deps --no-build-isolation -e . 2>/dev/null || true

RUN mkdir -p data/dem_cache models/foundation models/matchers logs \
    && chown -R "${APP_USER}:${APP_USER}" /app

USER ${APP_USER}

# NVIDIA runtime environment variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_DEVICE_ORDER=PCI_BUS_ID

HEALTHCHECK --interval=30s --timeout=15s --start-period=90s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "gui.backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--log-level", "info"]
